{
  "name": "bookmarks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "build:app": "tsc && vite build --config vite.production.config.ts && node scripts/finalize-app.mjs",
    "android:sync": "npm run build:app && cap sync android",
    "test:data": "node --import tsx --test tests/data.test.ts",
    "prepare:ocr": "node scripts/copy-ocr.mjs",
    "prebuild:app": "npm run prepare:ocr",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "test": "npm run test:data && npm run test:pwa && npm run test:sites"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
